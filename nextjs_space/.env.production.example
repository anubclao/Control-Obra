# =============================================
# Control Obra - Environment Variables (Hostinger)
# Produccion - ejemplo seguro
# =============================================

# Core runtime
NODE_ENV=production
NEXTAUTH_URL=https://tu-dominio.com
NEXTAUTH_SECRET=REEMPLAZAR_CON_SECRETO_LARGO_Y_ALEATORIO
DATABASE_URL=mysql://USUARIO:PASSWORD@HOST:3306/NOMBRE_DB

# SMTP OTP (Gmail recomendado con App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_de_16_caracteres
SMTP_FROM="Control Obra <tu_correo@gmail.com>"

# Database pool tuning
DB_POOL_CONNECTION_LIMIT=20
DB_POOL_QUEUE_LIMIT=0
DB_VERIFY_STRICT=0

# Redis (opcional si usas colas/reportes distribuidos)
REDIS_URL=redis://127.0.0.1:6379

# Financial report jobs (opcionales)
FINANCIAL_REPORT_CONCURRENCY=2
FINANCIAL_REPORT_JOB_CONCURRENCY=3
FINANCIAL_REPORT_JOB_HISTORY=200
FINANCIAL_REPORT_TTL_MS=86400000

# Build/runtime advanced (opcionales)
NEXT_DIST_DIR=.next
NEXT_OUTPUT_MODE=standalone
DEBUG=

# AWS S3 (opcional si usas almacenamiento en S3)
AWS_BUCKET_NAME=tu-bucket
AWS_FOLDER_PREFIX=control-obra

# SharePoint (opcional si usas integracion SharePoint)
SHAREPOINT_CLIENT_ID=tu-client-id
SHAREPOINT_ACCESS_TOKEN=tu-access-token
