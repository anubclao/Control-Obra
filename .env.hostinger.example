# =============================================================================
# Plantilla de .env para producción (Hostinger compartido)
# =============================================================================
# Copiá este archivo como .env.production o como .env.local cuando quieras
# apuntar a Hostinger. NO commitear nunca con la contraseña real.
#
# En Hostinger el panel te da estos datos en:
#   Panel → Bases de datos MySQL → click en la BD → "Detalles"
#
# IMPORTANTE: la BD NO se llama "control_obra", se llama con tu prefijo
# (ej. u652436213_ControlObra). El script 000_replica_hostinger.sql
# usa DATABASE() y no la hardcodea, así que funciona con cualquier nombre.
# =============================================================================

# Host MySQL (NO es el del hosting, es el del servidor de BD)
# En Hostinger compartido suele verse como: srvXXX.hstgr.io
# o como la IP interna que te da el panel
DB_HOST=srv123.hstgr.io
DB_PORT=3306
DB_USER=u652436213_ControlObraMT
DB_PASSWORD=              # ← pegar la contraseña acá (NO commitear)
DB_NAME=u652436213_ControlObra
DB_POOL_SIZE=10

# Auth de la app
SESSION_SECRET=            # ← generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_URL=https://tudominio.com

# SharePoint (opcional, solo si vas a usar la generación de documentos)
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_SITE_ID=
SP_DRIVE_ID=
SP_BASE_PATH=Proyectos
